# 学迹 / BookMind — example environment configuration.
# Copy to `.env` and edit. Never commit a real API key (`.env` is gitignored).
#
# On startup the app auto-loads `.env` next to the project root and injects every
# KEY=VALUE into the environment (a real env var always wins over the file).
# So the LLM API key below can be set right here in `.env` — no per-shell export
# needed. The key is read by env-var name, never stored as a Settings field, so
# it cannot leak via a Settings dump.

BOOKMIND_ENV=development

# Persistence. Default = single-machine SQLite. For Docker standard deployment
# use postgresql://bookmind:bookmind@db:5432/bookmind (set by docker-compose).
# Use "memory://" to force the in-memory repository (tests / ephemeral demo).
BOOKMIND_DATABASE_URL=sqlite:///./data/bookmind.db
BOOKMIND_DATA_DIR=./data

# Document processing. The private PP-StructureV3 service is optional; in
# auto mode only low-quality or complex pages are sent to it.
BOOKMIND_DOCUMENT_PARSER=auto
BOOKMIND_DOCUMENT_PARSER_URL=
BOOKMIND_DOCUMENT_PARSER_TIMEOUT=300
BOOKMIND_PARSE_BATCH_PAGES=10
BOOKMIND_INGESTION_WORKERS=1
BOOKMIND_CHAT_WORKERS=4
BOOKMIND_QA_DEADLINE_SECONDS=75

# Real sample textbook used by the welcome-page quick start. Relative paths
# are resolved from the BookMind project root.
BOOKMIND_SAMPLE_BOOK_PATH=dsacpp-3rd-edn.pdf
BOOKMIND_SAMPLE_BOOK_TITLE=数据结构（C++语言版）第三版

# Network. 18765 avoids the 8765 collision on some Windows machines.
BOOKMIND_HOST=127.0.0.1
BOOKMIND_PORT=18765
BOOKMIND_CORS_ORIGINS=http://127.0.0.1:18765
# Optional in deployment; when empty, a private key is generated under data/.
BOOKMIND_SESSION_SECRET=

# DeepSeek official OpenAI-compatible API. Either set DEEPSEEK_API_KEY in the
# environment or point BOOKMIND_LLM_API_KEY_FILE at a raw key file.
BOOKMIND_LLM_BASE_URL=https://api.deepseek.com
BOOKMIND_LLM_API_KEY_ENV=DEEPSEEK_API_KEY
BOOKMIND_LLM_API_KEY_FILE=

# DeepSeek has no official embedding/rerank endpoints. The product uses BM25
# recall and DeepSeek chat JSON scoring over the small candidate shortlist.
BOOKMIND_CHAT_MODEL=deepseek-flash
BOOKMIND_EMBEDDING_MODEL=
BOOKMIND_RERANK_MODEL=deepseek-flash

# The actual API key — uncomment and paste here. `.env` is gitignored.
# DEEPSEEK_API_KEY=sk-...
